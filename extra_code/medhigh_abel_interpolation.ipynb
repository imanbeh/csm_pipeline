      "\u001b[38;5;28;01mdef\u001b[39;00m ray_calculation(image, cx,cy, n_lines, n_pts, plot=\u001b[38;5;28;01mTrue\u001b[39;00m):\n",
      "    \u001b[33m'''\u001b[39m\n",
      "\u001b[33m    returns n_lines rays of n_pts long radial profiles, and corresponding array of cartesian coordinates\u001b[39m\n",
      "\n",
      "\u001b[33m    image = 2d array image to be interpolated\u001b[39m\n",
      "\u001b[33m    cx = x center\u001b[39m\n",
      "\u001b[33m    cy = y center\u001b[39m\n",
      "\u001b[33m    n_lines = number of rays\u001b[39m\n",
      "\u001b[33m    n_pts = number of points along rays\u001b[39m\n",
      "\u001b[33m    plot = booleon T/F to plot resulting interpolated grid\u001b[39m\n",
